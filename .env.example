# API backend Blyss. app.blyssapp.fr sert /api/* (nginx → Node) sur le VPS.
# Bascule sur https://api.blyssapp.fr quand le sous-domaine sera créé.
NEXT_PUBLIC_BLYSS_API_URL=https://app.blyssapp.fr

# Clé publishable Stripe (plateforme). Test en preview, live en prod.
# = EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY dans blyss-mobile/eas.json
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
